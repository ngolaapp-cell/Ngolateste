# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Password for accessing the Painel do Administrador
ADMIN_PASSWORD="ngola2025"
ADMIN_RECOVERY_EMAIL="ngolaapp@gmail.com"

# SMTP / EMAIL CONFIGURATION (Optional for sending recovery emails via Gmail SMTP, Custom SMTP, or Resend)
# For Gmail accounts (@gmail.com): SMTP_USER is your email, and SMTP_PASS must be a 16-character Google App Password (myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NgolaTeste <suporte@ngolateste.ao>"
RESEND_API_KEY=

# SUPABASE INTEGRATION:
# Set your Supabase URL and Anon Key in Settings -> Environment Variables or .env
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
